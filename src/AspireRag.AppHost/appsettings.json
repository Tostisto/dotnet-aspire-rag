{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Ollama": {
    "UseLocal": true
  },
  "Documents": {
    "Folders": [
      {
        "Name": "vscode-wiki",
        "Path": "../../refs/vscode.wiki",
